{
  "name": "lunch-order",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/notifications": "*",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.13.6",
    "express": "^4",
    "mailtrap": "^4.4.0",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-without-livereload": "cds watch --no-live-reload",
    "start-ui": "cd app/lunch-ui && npm run dev",
    "start-local": "concurrently \"npm run watch-without-livereload\" \"cd app/lunch-ui && npm run dev\"",
    "deploy:notification-types": "node srv/deploy-notification-types.js"
  },
  "private": true,
  "cds": {
    "server": {
      "port": 4005
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "sarah.johnson@example.com": {
              "roles": [
                "CMNA_ADMIN",
                "CMNA_ADD_USER",
                "CMNA_DELETE_USER",
                "CMNA_READ_ASSIGNED_USER",
                "CMNA_READ_ALL_USER",
                "CMNA_UPDATE_USER"
              ]
            },
            "bob": {
              "roles": [
                "CMNA_READ_ASSIGNED_USER"
              ]
            }
          }
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          },
          "watch": {
            "ignore": [
              "app/**"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana",
        "destinations": true,
        "html5-repo": true,
        "application-logging": true
      },
      "notifications": {
        "[development]": {
          "kind": "notify-to-console"
        },
        "[hybrid]": {
          "kind": "notify-to-rest",
          "destination": "SAP_Notifications"
        },
        "[production]": {
          "kind": "notify-to-rest",
          "destination": "SAP_Notifications"
        },
        "prefix": "$app-name",
        "types": "srv/notification-types.json",
        "outbox": true
      }
    }
  }
}
